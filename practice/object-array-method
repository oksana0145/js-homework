// ===== 3.7 · Середній бал — ✅ пройдено
{
  const students = [
    { name: "Оля", grade: 90 },
    { name: "Іван", grade: 60 },
    { name: "Марта", grade: 75 },
  ];

  const total = students.reduce((sum, grade) => {
  return sum + grade.grade;
  } , 0);

  const avgr = total / students.length;

  console.log(`Середній бал: ${avgr}`);
}

