  ];

  const counts = students.reduce( (city, student) => {
  student["city"] in city ? city[student.city] : city[student.city] = 0;
  city[student.city]++;
  return city;
  }, {})

  console.log(counts["Львів"]);
  console.log(counts["Київ"]);
}

